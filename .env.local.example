# Get your project ID from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here

# Vault platforms

# UltraYield vault addresses (comma-separated, optional @chainId per vault)
# Plain address uses NEXT_PUBLIC_ULTRAYIELD_CHAIN_ID as fallback (default: 1 = Ethereum mainnet)
# Example: 0x<addr1>@1,0x<addr2>@8453
NEXT_PUBLIC_ULTRAYIELD_VAULT_ADDR=0x<addr1>,0x<addr2>@<chainId>
NEXT_PUBLIC_ULTRAYIELD_CHAIN_ID=1

# Morpho vault addresses (comma-separated, EVM checksummed)
NEXT_PUBLIC_MORPHO_VAULT_ADDR=0x<addr1>@<chainId>,0x<addr2>@8453 # Example: addr@chainId,0xBEEF01735c132Ada46AA9aA4c54623cAA92A64CB@1,0xeE8F4eC5672F09119b96Ab6fB59C27E1b7e44b61@8453
