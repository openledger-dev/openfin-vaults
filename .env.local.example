# ─── Reown / WalletConnect ────────────────────────────────────────────────────
# Get your project ID from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here

# ─── Vault platforms ──────────────────────────────────────────────────────────

# UltraYield vault addresses (comma-separated, optional @chainId per vault)
# Plain address uses NEXT_PUBLIC_ULTRAYIELD_CHAIN_ID as fallback (default: 1)
# Example: 0x<addr1>@1,0x<addr2>@8453
NEXT_PUBLIC_ULTRAYIELD_VAULT_ADDR=0x<addr1>,0x<addr2>@<chainId>
NEXT_PUBLIC_ULTRAYIELD_CHAIN_ID=1

# Morpho vault addresses — use address@chainId format to support multi-chain
# Example: 0xBEEF01735c132Ada46AA9aA4c54623cAA92A64CB@1,0xeE8F4eC5672F09119b96Ab6fB59C27E1b7e44b61@8453
NEXT_PUBLIC_MORPHO_VAULT_ADDR=0x8eB67A509616cd6A7c1B3c8C21D48FF57df3d458@1,0xBEEF01735c132Ada46AA9aA4c54623cAA92A64CB@1,0xc1256Ae5FF1cf2719D4937adb3bbCCab2E00A2Ca@8453

# Midas vault addresses — share-token addresses (Ethereum mainnet, chainId 1)
# NEXT_PUBLIC_MIDAS_VAULT_ADDR=0x<mtbill_address>,0x<mbasis_address>
# NEXT_PUBLIC_MIDAS_CHAIN_ID=1

# ─── Redis ────────────────────────────────────────────────────────────────────
# Server-side only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
#
# Local dev (requires a running Redis instance):
#   REDIS_URL=redis://localhost:6379
#
# Upstash (serverless-friendly, free tier available at https://upstash.com):
#   REDIS_URL=rediss://:<password>@<host>.upstash.io:6380
#
# Redis Cloud / Render / Railway — use the connection string from your provider.
# Omit this variable entirely to run without caching (API calls go directly to
# external services on every request).
REDIS_URL=redis://localhost:6379

# ─── Cache TTLs (seconds) ─────────────────────────────────────────────────────
# All optional — hardcoded defaults are shown as comments.
# Increase to reduce upstream API/RPC load; decrease for fresher data.
#
# REDIS_TTL_META=3600      # 1 hour   — vault name, decimals, fees, oracle addresses
# REDIS_TTL_STATE=30       # 30 sec   — TVL, totalSupply, paused flag
# REDIS_TTL_APY=300        # 5 min    — off-chain APY (Morpho / Midas APIs)
# REDIS_TTL_APY_7D=86400   # 24 hours — UltraYield 7D APY (eth_getLogs scan, expensive)
# REDIS_TTL_PRICE=600      # 10 min   — Midas token prices
# REDIS_TTL_PENDING=60     # 1 min    — user-specific pending redemptions

# ─── RPC endpoints ────────────────────────────────────────────────────────────
# Server-side only — used by the /api/vaults/metadata and /api/vaults/state
# routes to read on-chain data without the browser.
#
# Public fallback RPCs are built-in (LlamaRPC), but they are rate-limited.
# For production, use a dedicated provider (Alchemy, Infura, QuickNode, etc.).
#
# Format: RPC_URL_<chainId>=https://...
RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/<your_key>
RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/<your_key>
# RPC_URL_10=https://opt-mainnet.g.alchemy.com/v2/<your_key>
# RPC_URL_42161=https://arb-mainnet.g.alchemy.com/v2/<your_key>

NEXT_PUBLIC_SHOW_ALLOCATION=false
