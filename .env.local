# ─── Reown / WalletConnect ────────────────────────────────────────────────────
# Get your project ID at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=cc8c55624f2a2ba415ef402cc41eb0c0

# ─── UltraYield Vault Addresses ───────────────────────────────────────────────
# Comma-separated list of deployed UltraVault proxy addresses to display.
# The app fetches name, symbol, asset, totalAssets, paused state, and fees
# directly from each contract via multicall (wagmi useReadContracts).
#
# Example (mainnet):
# NEXT_PUBLIC_ULTRAYIELD_VAULT_ADDR=0xVaultAddress1,0xVaultAddress2

NEXT_PUBLIC_ULTRAYIELD_CHAIN_ID=1
NEXT_PUBLIC_ULTRAYIELD_VAULT_ADDR=0x546329A16DcEdC46e93F7b03A65F49A84700bca1,0xc46efCc8e39c8f02425e367423871cD4633b7908,0x472425CC95Be779126AfA4Aa17980210D299914F@1
NEXT_PUBLIC_MORPHO_VAULT_ADDR=0xBEEF01735c132Ada46AA9aA4c54623cAA92A64CB@1,0xeE8F4eC5672F09119b96Ab6fB59C27E1b7e44b61@8453
# NEXT_PUBLIC_MIDAS_VAULT_ADDR=0x238a700eD6165261Cf8b2e544ba797BC11e466Ba

# ─── 1inch API ────────────────────────────────────────────────────────────────
# Get your API key at https://portal.1inch.dev
ONEINCH_API_KEY=

# ─── NEAR Intents / 1Click Swap API ──────────────────────────────────────────
# JWT token to avoid the 0.2% fee on swaps.
# Get yours at: https://docs.near-intents.org/integration/distribution-channels/1click-api/authentication
# Leave empty to use the API without a JWT (0.2% fee applies).
ONECLICK_JWT_TOKEN=

# Minimum swap value in USD. Amounts below this are rejected client-side to
# avoid "Failed to get quote" errors from market makers. Default: 5
NEXT_PUBLIC_SWAP_MIN_USD=1

REDIS_URL=redis://localhost:6379
RPC_URL_1=https://mainnet.infura.io/v3/2dcbe335114c4927a5cd5ab9c1fc7490
RPC_URL_8453=https://base-mainnet.infura.io/v3/2dcbe335114c4927a5cd5ab9c1fc7490
